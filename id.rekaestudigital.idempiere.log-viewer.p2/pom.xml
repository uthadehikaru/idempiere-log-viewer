<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>id.rekaestudigital</groupId>
    <artifactId>idempiere-log-viewer-parent</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>id.rekaestudigital.idempiere.log-viewer.p2</artifactId>
  <name>IDempiere Log Viewer p2 Repository</name>
  <packaging>eclipse-repository</packaging>
  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target combine.self="override">
            <file>${idempiere.tycho.target}</file>
          </target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-repository-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- Publish only the log viewer bundle, not the iDempiere platform it depends on. -->
          <includeAllDependencies>false</includeAllDependencies>
          <repositoryName>iDempiere Log Viewer</repositoryName>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
