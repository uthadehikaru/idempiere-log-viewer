<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>id.rekaestudigital</groupId>
    <artifactId>idempiere-log-viewer-parent</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>id.rekaestudigital.idempiere.log-viewer</artifactId>
  <name>IDempiere Log Viewer</name>
  <description>IDempiere Log Viewer Plugin</description>
  <packaging>eclipse-plugin</packaging>
  <properties>
    <!-- Parent runs clean on every build by default; keep the Tycho target file. -->
    <skipClean>true</skipClean>
  </properties>
  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- Parent target uses ${project_loc:...}, which only resolves inside the iDempiere reactor. -->
          <target combine.self="override">
            <file>${idempiere.tycho.target}</file>
          </target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>build-from-plugin-directory</id>
      <activation>
        <file>
          <missing>${maven.multiModuleProjectDirectory}/id.rekaestudigital.idempiere.log-viewer/pom.xml</missing>
        </file>
      </activation>
      <properties>
        <idempiere.tycho.target>${project.basedir}/idempiere-13.target</idempiere.tycho.target>
      </properties>
    </profile>
  </profiles>
</project>
